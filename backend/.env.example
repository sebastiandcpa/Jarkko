# JARVIS - EKKO :: backend configuration
# Copia este archivo como `.env` y ajusta los valores.
# Todas las variables usan el prefijo JARVIS_.
# NUNCA subas tu archivo .env real a un repositorio.

# ---------------------------------------------------------------
# Servidor
# ---------------------------------------------------------------
JARVIS_HOST=127.0.0.1
JARVIS_PORT=8765

# Orígenes permitidos para CORS (separados por comas).
# El frontend de desarrollo (Vite) corre en 5173 y el preview en 4173.
JARVIS_CORS_ORIGINS=http://127.0.0.1:5173,http://localhost:5173,http://127.0.0.1:4173,http://localhost:4173

# ---------------------------------------------------------------
# Proveedor de IA
# ---------------------------------------------------------------
# mock | openai | anthropic | gemini
# `mock` no requiere API key y funciona totalmente offline.
JARVIS_AI_PROVIDER=mock

# Modelo a usar cuando el proveedor sea externo (vacío = el default del proveedor).
JARVIS_AI_MODEL=

# API key del proveedor externo. Déjala vacía para usar el MockAIProvider.
# El backend nunca escribe este valor en logs ni en la base de datos.
JARVIS_AI_API_KEY=

# ---------------------------------------------------------------
# Seguridad
# ---------------------------------------------------------------
# Nivel de riesgo mínimo que exige confirmación explícita del usuario:
# low | medium | high | critical
JARVIS_CONFIRMATION_THRESHOLD=high

# Habilita herramientas de riesgo CRITICAL (p.ej. delete_file).
# Por defecto están registradas pero bloqueadas.
JARVIS_ENABLE_CRITICAL_TOOLS=false

# Raíces adicionales permitidas para operaciones de archivos (separadas por comas).
# El home del usuario siempre está permitido. Ejemplo: D:\Proyectos,E:\Media
JARVIS_EXTRA_ALLOWED_ROOTS=

# Segundos de validez de una confirmación pendiente.
JARVIS_CONFIRMATION_TTL_SECONDS=300

# ---------------------------------------------------------------
# Comportamiento
# ---------------------------------------------------------------
# google | duckduckgo | bing
JARVIS_SEARCH_ENGINE=google

# Intervalo (segundos) de los eventos system.status por WebSocket.
JARVIS_SYSTEM_STATUS_INTERVAL=5

# Ruta del archivo SQLite (relativa a backend/ si no es absoluta).
JARVIS_DATABASE_PATH=data/jarvis.db

# Nivel de log: DEBUG | INFO | WARNING | ERROR
JARVIS_LOG_LEVEL=INFO
